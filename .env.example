# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=rss_user
POSTGRES_PASSWORD=rss_password
POSTGRES_DB=rightsizing_db

# ─────────────────────────────────────────
# Backend / FastAPI
# ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rss_user:rss_password@localhost:5432/rightsizing_db
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin seed credentials (used on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────
# Frontend / Vite
# ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
